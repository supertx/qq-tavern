# Copy to .env. This file contains placeholders only.
# Only required for manual mode. Leave both empty for QR mode.
QQ_APP_ID=
QQ_APP_SECRET=
# Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=
MODEL_API_MODE=responses
REASONING_EFFORT=medium
# Leave blank to use MODEL_NAME. Set summary effort to one supported by this model.
SUMMARY_MODEL=
SUMMARY_REASONING_EFFORT=medium
# Receiving all group messages requires the corresponding QQ permission.
QQ_OBSERVE_GROUP_MESSAGES=false
GATEWAY_PORT=18700
WORKER_PORT=18710
MAX_CONCURRENCY=4

# Optional: supply all three to enable image generation/edit tools.
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
# Optional: OpenAI-compatible speech endpoint. No bundled Edge TTS implementation.
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_VOICE=alloy
# Optional: SearXNG instance with JSON search enabled.
SEARXNG_URL=

# Zhipu GLM-5.3/Flash example (supports low/high/max, not medium):
# MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL_API_MODE=chat_completions
# MODEL_NAME=glm-5.3-flash
# REASONING_EFFORT=high
# SUMMARY_MODEL=glm-5.3
# SUMMARY_REASONING_EFFORT=high
