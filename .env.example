# qq-traven common settings. Placeholders only; never put secrets in this file.
# For a NEW deployment, combine this file with exactly ONE template from
# config/models/*.env.example, then save as .env. See config/models/README.md.
# Existing deployments can keep their current .env unchanged.
# Only required for manual mode. Leave both empty for QR mode.
QQ_APP_ID=
QQ_APP_SECRET=
# Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=
# Optional instance management API. Generate a DIFFERENT token (32+ characters).
# Empty disables the API. QQ command groups are still closed by default.
ADMIN_API_TOKEN=
# Use a different project name and ports for each instance.
# COMPOSE_PROJECT_NAME=qq-instance-a
# Receiving all group messages requires the corresponding QQ permission.
QQ_OBSERVE_GROUP_MESSAGES=false
GATEWAY_PORT=18700
WORKER_PORT=18710
MAX_CONCURRENCY=4

# Optional: supply all three to enable image generation/edit tools.
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
# Optional: separate editing model; empty means IMAGE_MODEL.
IMAGE_EDIT_MODEL=
# Optional: OpenAI-compatible speech endpoint. No bundled Edge TTS implementation.
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_VOICE=alloy
# Optional: SearXNG instance with JSON search enabled.
SEARXNG_URL=
