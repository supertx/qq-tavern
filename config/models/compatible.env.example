# Other compatible providers or self-hosted gateways.
# Usage: config/models/compatible.md
# Set the API base only; do NOT append /chat/completions or /responses.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Choose responses or chat_completions to match the provider.
MODEL_API_MODE=chat_completions
# Must be accepted by your model; this app always sends reasoning effort.
REASONING_EFFORT=medium
# Empty = use MODEL_NAME. Uses the SAME base URL, API key and protocol.
SUMMARY_MODEL=
SUMMARY_REASONING_EFFORT=medium
