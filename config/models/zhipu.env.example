# Zhipu GLM standard API. Usage: config/models/zhipu.md
# Combine with the root .env.example for a NEW deployment.
MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_API_KEY=
MODEL_NAME=glm-5.3-flash
MODEL_API_MODE=chat_completions
REASONING_EFFORT=high
# Empty = use MODEL_NAME. Uses the SAME base URL, API key and protocol.
SUMMARY_MODEL=
SUMMARY_REASONING_EFFORT=high
