# OpenAI API. Usage: config/models/openai.md
# Combine with the root .env.example for a NEW deployment.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
# Set a model available to your API account with Responses + function calling.
MODEL_NAME=
MODEL_API_MODE=responses
REASONING_EFFORT=medium
# Empty = use MODEL_NAME. Uses the SAME base URL, API key and protocol.
SUMMARY_MODEL=
SUMMARY_REASONING_EFFORT=medium
